%%{init: {"theme":"base","themeVariables":{"background":"#FFFEF9","fontFamily":"Helvetica, Arial, sans-serif","fontSize":"14px","lineColor":"#222","primaryTextColor":"#111"}}}%%
erDiagram
  SOURCE ||--o{ SNAPSHOT : "frozen as"
  SNAPSHOT ||--o{ ENTRY : "yields"
  ENTRY ||--o{ ENTRY : "parent of"
  CONFLICT }o--|{ ENTRY : "links"
  RELEASE }o--|{ SNAPSHOT : "pins one per Source"
  GOLD_LABEL }o--o{ ENTRY : "cites"
  SOURCE {
    string id PK
    string connector
    string locator
    string redactions
  }
  SNAPSHOT {
    string id PK "sha256"
    string source FK
    datetime fetchedAt
    string connectorVersion
  }
  ENTRY {
    string id PK
    string type
    string snapshot FK
    string parent FK
    string employer
    string title
    string start
    string end
    string quote
    string span
  }
  CONFLICT {
    string id PK
    string topicTerms
    string rule
  }
  RELEASE {
    string version PK
    string previousVersion
    string fileHashes
  }
  GOLD_LABEL {
    string questionId PK
    string category
    string mustContain
    string mustNotClaim
    boolean verified
  }
