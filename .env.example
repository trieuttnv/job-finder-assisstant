# Copy to .env and set ANTHROPIC_API_KEY. Never commit .env.

# Model
ANTHROPIC_API_KEY=
# Only to point at a local mock of the Anthropic API; leave unset for real calls.
# ANTHROPIC_BASE_URL=
MODEL_PROVIDER=anthropic
MODEL_ID=claude-haiku-4-5
MODEL_TIMEOUT_MS=20000
MODEL_MAX_OUTPUT_TOKENS=800

# Retrieval
RETRIEVAL_TOP_K=6

# Prompt, knowledge and traces
PROMPT_VERSION=answer-v1
KNOWLEDGE_DIR=knowledge
TRACE_DIR=traces
# The previous run's Entry ids, for the startup report of added, changed and removed ids.
STATE_DIR=.state
