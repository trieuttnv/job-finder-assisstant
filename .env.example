# Copy to .env and set the key for the provider you use. Never commit .env.

# Model: anthropic (default) or deepseek. DeepSeek stores data in China; choose it explicitly.
MODEL_PROVIDER=anthropic
# Empty means the provider's default (claude-sonnet-5-5, deepseek-flash). An id of the other
# provider stops startup.
MODEL_ID=
MODEL_TIMEOUT_MS=20000
MODEL_MAX_OUTPUT_TOKENS=800
# US dollars per million tokens, for the cost in each trace. Empty uses claude-sonnet-5-5's list
# price ($2 / $10); other models then record no cost, so set both for DeepSeek.
MODEL_PRICE_IN_USD_PER_MTOK=
MODEL_PRICE_OUT_USD_PER_MTOK=

ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Only to point an adapter at a local stub of its API; leave unset for real calls.
# ANTHROPIC_BASE_URL=
# DEEPSEEK_BASE_URL=

# Retrieval
RETRIEVAL_TOP_K=6
# Input Guardrail floor on the best BM25 score; below it the model is not called. Provisional
# until the dev split exists: unrelated questions score 0, the weakest real one about 1.45.
RETRIEVAL_MIN_SCORE=0.5

# Output Guardrail: above this share of dropped claims, the answer is withheld as unverified.
GUARD_MAX_DROP_RATIO=0.5

# Prompt, knowledge and traces
PROMPT_VERSION=answer-v4
KNOWLEDGE_DIR=knowledge
TRACE_DIR=traces
# The previous run's Entry ids, for the startup report of added, changed and removed ids.
STATE_DIR=.state
